<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="mybatis.mapper.DepartmentMapper">
  <resultMap id="EmployeeCollectionMap" type="mybatis.model.Employee">
    <id column="id" jdbcType="INTEGER" property="id" />
    <result column="first_name" jdbcType="VARCHAR" property="firstName" />
    <result column="last_name" jdbcType="VARCHAR" property="lastName" />
  </resultMap>
  <resultMap id="BaseResultMap" type="mybatis.model.Department">
    <id column="id" jdbcType="INTEGER" property="id" />
    <result column="name" jdbcType="VARCHAR" property="name" />
  </resultMap>
  <resultMap id="DepartmentWithEmployeesMap" type="mybatis.model.Department">
    <id column="id" jdbcType="INTEGER" property="id" />
    <result column="name" jdbcType="VARCHAR" property="name" />
    <collection property="employees" ofType="mybatis.model.Employee" resultMap="EmployeeCollectionMap"/>
  </resultMap>
  <delete id="deleteByPrimaryKey" parameterType="java.lang.Integer">
    delete from public.department
    where id = #{id,jdbcType=INTEGER}
  </delete>
  <insert id="insert" keyColumn="id" keyProperty="id" parameterType="mybatis.model.Department" useGeneratedKeys="true">
    insert into public.department (name)
    values (#{name,jdbcType=VARCHAR})
  </insert>
  <update id="updateByPrimaryKey" parameterType="mybatis.model.Department">
    update public.department
    set name = #{name,jdbcType=VARCHAR}
    where id = #{id,jdbcType=INTEGER}
  </update>
  <select id="selectByPrimaryKey" parameterType="java.lang.Integer" resultMap="DepartmentWithEmployeesMap">
    SELECT
    d.id,
    d.name,
    e.id,
    e.first_name,
    e.last_name
    FROM public.department d
    LEFT JOIN public.employee e ON d.id = e.department_id
    WHERE d.id = #{id,jdbcType=INTEGER}
  </select>
  <select id="selectAll" resultMap="BaseResultMap">
    SELECT
    d.id,
    d.name
    FROM public.department d
  </select>
  <select id="selectAllWithEmployees" resultMap="DepartmentWithEmployeesMap">
    SELECT
      d.id,
      d.name,
      e.id,
      e.first_name,
      e.last_name
    FROM
      public.department d
        LEFT JOIN
        public.employee e ON d.id = e.department_id
    ORDER BY d.id
  </select>
</mapper>