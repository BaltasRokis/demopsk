<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="mybatis.mapper.ProjectEmployeeMapper">
  <resultMap id="BaseResultMap" type="mybatis.model.ProjectEmployee">
    <result column="project_id" jdbcType="INTEGER" property="projectId" />
    <result column="employee_id" jdbcType="INTEGER" property="employeeId" />
  </resultMap>
  <insert id="insert" parameterType="mybatis.model.ProjectEmployee">
    insert into public.project_employee (project_id, employee_id)
    values (#{projectId,jdbcType=INTEGER}, #{employeeId,jdbcType=INTEGER})
  </insert>
  <select id="selectAll" resultMap="BaseResultMap">
    select project_id, employee_id
    from public.project_employee
  </select>
  <delete id="deleteAllProjectsForEmployee" parameterType="java.lang.Integer">
    DELETE FROM public.project_employee
    WHERE employee_id = #{employeeId,jdbcType=INTEGER}
  </delete>
  <delete id="deleteProjectForEmployee" parameterType="mybatis.model.ProjectEmployee">
    DELETE FROM public.project_employee
    WHERE employee_id = #{employeeId,jdbcType=INTEGER} AND project_id = #{projectId,jdbcType=INTEGER}
  </delete>
  <delete id="deleteAllEmployeesForProject" parameterType="java.lang.Integer">
    DELETE FROM public.project_employee
    WHERE project_id = #{projectId, jdbcType=INTEGER}
  </delete>
</mapper>